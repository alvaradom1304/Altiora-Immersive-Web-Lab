{
  "name": "altiora-immersive-web-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Investigación y proceso reproducible para experiencias web inmersivas",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/verify-catalog.mjs && node scripts/audit-skills.mjs && node scripts/build-agents.mjs --check && npm run continuity:check && npm run visual:preflight:test && npm run visual:watch:test && npm run video:master:test && npm run adobe:test && npm run after-effects:test",
    "agents:build": "node scripts/build-agents.mjs",
    "chat": "node scripts/team-chat.mjs",
    "skills:audit": "node scripts/audit-skills.mjs",
    "skills:baseline": "node scripts/audit-skills.mjs --write",
    "reference": "node scripts/fetch-reference.mjs",
    "resume": "node scripts/continuity.mjs",
    "continuity:check": "node scripts/continuity.mjs --check && node --test scripts/continuity.test.mjs",
    "visual:preflight": "node scripts/visual-preflight.mjs",
    "visual:preflight:test": "node --test scripts/visual-preflight.test.mjs",
    "visual:watch": "node scripts/visual-watch.mjs",
    "visual:watch:test": "node --test scripts/visual-watch.test.mjs",
    "visual:license:check": "node scripts/verify-catalog.mjs",
    "video:master:test": "node --test experiments/tilicheros-motion-lab/scripts/verify-master.test.mjs",
    "adobe:check": "node scripts/after-effects-bridge.mjs --check",
    "adobe:test": "node --test scripts/after-effects-bridge.test.mjs",
    "after-effects:check": "node scripts/after-effects-bridge.mjs --check",
    "after-effects:test": "node --test scripts/after-effects-bridge.test.mjs"
  }
}
