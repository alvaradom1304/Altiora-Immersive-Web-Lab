{
  "name": "altiora-immersive-web-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Investigación y proceso reproducible para experiencias web inmersivas",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:base && npm run operations:test && npm run toolkit:test && npm run runtime:test && npm run librarian:test && npm run routing:eval && npm run audio:test",
    "check:base": "node scripts/verify-catalog.mjs && node scripts/audit-skills.mjs && node scripts/build-agents.mjs --check && npm run continuity:check && npm run visual:preflight:test && npm run visual:watch:test && npm run video:master:test && npm run adobe:test && npm run ae:clients:test && npm run after-effects:setup:test",
    "agents:build": "node scripts/build-agents.mjs",
    "chat": "node scripts/team-chat.mjs",
    "skills:audit": "node scripts/audit-skills.mjs",
    "skills:baseline": "node scripts/audit-skills.mjs --write",
    "reference": "node scripts/fetch-reference.mjs",
    "resume": "node scripts/continuity.mjs",
    "continuity:check": "node scripts/continuity.mjs --check && node --test scripts/continuity.test.mjs",
    "visual:preflight": "node scripts/visual-preflight.mjs",
    "visual:preflight:test": "node --test scripts/visual-preflight.test.mjs",
    "visual:watch": "node scripts/visual-watch.mjs",
    "visual:watch:test": "node --test scripts/visual-watch.test.mjs",
    "visual:license:check": "node scripts/verify-catalog.mjs",
    "video:master:test": "node --test experiments/tilicheros-motion-lab/scripts/verify-master.test.mjs",
    "adobe:check": "node scripts/after-effects-bridge.mjs --check",
    "adobe:test": "node --test scripts/after-effects-bridge.test.mjs",
    "after-effects:check": "node scripts/after-effects-bridge.mjs --check",
    "after-effects:test": "node --test scripts/after-effects-bridge.test.mjs",
    "ae:clients:plan": "node scripts/connect-after-effects.mjs --plan",
    "ae:clients:connect": "node scripts/connect-after-effects.mjs --apply",
    "ae:clients:test": "node --test scripts/connect-after-effects.test.mjs scripts/after-effects-mcp.test.mjs",
    "after-effects:mcp:test": "node --test scripts/after-effects-mcp.test.mjs",
    "after-effects:setup:test": "node --test scripts/setup-after-effects-access.test.mjs",
    "after-effects:setup": "node scripts/setup-after-effects-access.mjs",
    "capability:doctor": "node scripts/capability-doctor.mjs",
    "operations:test": "node --test scripts/capability-doctor.test.mjs scripts/production-qa.test.mjs",
    "routing:eval": "python skills/altiora-bibliotecario/scripts/evaluate_routes.py",
    "production:qa": "node scripts/production-qa.mjs",
    "skills:compact": "node scripts/compact-skills.mjs",
    "project:identity": "node scripts/project-identity.mjs",
    "toolkit:test": "node --test scripts/compact-skills.test.mjs scripts/project-identity.test.mjs",
    "runtime:smoke": "python scripts/runtime-smoke.py",
    "runtime:test": "python -m unittest discover -s scripts -p test_runtime_smoke.py",
    "librarian:test": "python -m unittest discover -s skills/altiora-bibliotecario/scripts -p \"test_*.py\"",
    "audio:test": "python -m unittest discover -s skills/audio-production/scripts -p test_audio_qa.py"
  }
}
